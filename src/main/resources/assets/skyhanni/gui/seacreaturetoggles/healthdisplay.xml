<Root xmlns="http://notenoughupdates.org/moulconfig">
    <Gui>
        <Column>
            <Meta afterClose="@afterClose"/>
            <Center>
                <Scale scale="2">
                    <Text text="Show on Health Display Toggles"/>
                </Scale>
            </Center>
            <Spacer height="5"/>
            <ScrollPanel width="350" height="200">
                <Array data="@seaCreatures">
                    <Row>
                        <Switch value="@shouldShowHealthOverlay"/>
                    </Row>
                </Array>
            </ScrollPanel>
        </Column>
    </Gui>
</Root>
